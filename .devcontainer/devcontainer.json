// Development environment for the Hangman project.
// Open the repository in VS Code (or any devcontainer-compatible IDE) and choose
// "Reopen in Container". See https://containers.dev/ for the specification.
//
// Windows: for best performance, clone the repository inside WSL 2
{
  "name": "Hangman",
  "dockerComposeFile": "compose.yaml",
  "service": "workspace",
  // Must match the source mount in compose.yaml
  "workspaceFolder": "/workspaces/hangman",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    // Lets you run `docker build` / `docker compose` from inside the devcontainer
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      // moby packages are not available on Debian trixie: install Docker CE instead
      "moby": false
    }
  },
  // api, game, dashboard, mysql
  "forwardPorts": [8080, 5173, 5174, "mysql:3306"],
  "postCreateCommand": "sudo chown -R vscode:vscode game/node_modules dashboard/node_modules api/target /cache && make install",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-spring-boot",
        "dbaeumer.vscode-eslint",
        "ms-azuretools.vscode-containers"
      ]
    }
  }
}